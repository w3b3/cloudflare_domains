{
  "name": "cloudflare-domains-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for Cloudflare domains management",
  "scripts": {
    "api:install": "cd api && npm install",
    "ui:install": "cd ui && npm install",
    "install:all": "npm install && npm run api:install && npm run ui:install",
    "api:dev": "cd api && npm run dev",
    "ui:dev": "cd ui && npm run dev",
    "dev": "concurrently \"npm run api:dev\" \"npm run ui:dev\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
